<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="NopCommerce\Plugins\**" />
    <EmbeddedResource Remove="NopCommerce\Plugins\**" />
    <None Remove="NopCommerce\Plugins\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="NopCommerce\Libraries\Nop.Services\" />
    <Folder Include="NopCommerce\Libraries\Nop.Data\" />
    <Folder Include="NopCommerce\Presentation\Nop.Web.Framework\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NopCommerce\src\Libraries\Nop.Core\Nop.Core.csproj" />
    <ProjectReference Include="..\NopCommerce\src\Libraries\Nop.Data\Nop.Data.csproj" />
    <ProjectReference Include="..\NopCommerce\src\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" />
    <ProjectReference Include="..\NopCommerce\src\Presentation\Nop.Web\Nop.Web.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /Y/E &quot;$(ProjectDir)NopCommerce\Libraries\*&quot; &quot;$(SolutionDir)NopCommerce\src\Libraries\&quot;" />
    <Exec Command="xcopy /Y/E &quot;$(ProjectDir)NopCommerce\Presentation\*&quot; &quot;$(SolutionDir)NopCommerce\src\Presentation\&quot;" />
    <Exec Command="xcopy /Y/E &quot;$(ProjectDir)bin\$(Configuration)\net9.0\*.dll&quot; &quot;$(SolutionDir)NopCommerce\src\Presentation\Nop.Web\bin\$(Configuration)\net9.0\Custom\&quot;" />
  </Target>
</Project>