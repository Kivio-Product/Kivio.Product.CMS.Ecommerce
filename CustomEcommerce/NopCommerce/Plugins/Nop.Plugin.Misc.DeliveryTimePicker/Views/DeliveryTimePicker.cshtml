@model Nop.Plugin.Misc.DeliveryTimePicker.Models.DeliveryTimePickerPublicModel

@{
    NopHtml.AddCssFileParts("~/Plugins/Misc.DeliveryTimePicker/Content/delivery-time-picker.css");
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.DeliveryTimePicker/Scripts/delivery-time-picker.js");
    
    // Add inline script to initialize after the main script loads
    NopHtml.AddInlineScriptParts(ResourceLocation.Footer, $@"
        $(document).ready(function() {{
            if (typeof DeliveryTimePicker !== 'undefined') {{
                DeliveryTimePicker.init({{
                    hasExitoProducts: {Model.HasExitoProducts.ToString().ToLower()},
                    cutoffHour: {Model.CutoffHour}
                }});
            }} else {{
                console.error('DeliveryTimePicker script not loaded');
            }}
        }});
    ");
}

<div class="delivery-time-picker-wrapper" id="deliveryTimePickerSection">
    <div class="section-header">
        <h4>4. Fecha y hora de envío</h4>
    </div>
    
    <div class="delivery-time-picker-content">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label>Definir Fecha</label>
                    <input type="text" 
                           id="deliveryDatePicker" 
                           class="form-control delivery-date-input" 
                           placeholder="0 0 - 0 0 - 0 0 0 0"
                           readonly />
                    <small class="form-text text-muted">
                        Recuerda que por el momento no contamos con servicio los fines de semana o festivos
                    </small>
                    <div id="datePickerCalendar" class="calendar-wrapper" style="display: none;">
                        <!-- Calendar will be rendered here by JavaScript -->
                    </div>
                </div>
            </div>
            
            <div class="col-md-8">
                <div class="form-group">
                    <label>Rango de hora de entrega</label>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="small-label">Horario mínima de entrega</label>
                            <select id="minDeliveryTime" class="form-control time-select">
                                <option value="">10:00 am</option>
                            </select>
                            <small class="form-text text-info">
                                Click<br/>
                                Al hacer Click sale ventana emergente con calendario
                            </small>
                        </div>
                        <div class="col-md-6">
                            <label class="small-label">Horario máxima de entrega</label>
                            <select id="maxDeliveryTime" class="form-control time-select">
                                <option value="">02:00 pm</option>
                            </select>
                            <small class="form-text text-info">
                                Click<br/>
                                Al hacer Click se despliega las opciones de los horarios tanto en la parte de la mínima hora de entrega y la máxima hora de entrega
                            </small>
                        </div>
                    </div>
                </div>
                
                <div id="timeSlotOptions" class="time-slot-grid" style="display: none;">
                    <!-- Time slots will be populated here -->
                </div>
            </div>
        </div>
    </div>
    
    <!-- Hidden fields to store selected values -->
    <input type="hidden" id="selectedDeliveryDate" name="DeliveryDate" />
    <input type="hidden" id="selectedMinTime" name="MinDeliveryTime" />
    <input type="hidden" id="selectedMaxTime" name="MaxDeliveryTime" />
    <input type="hidden" id="selectedReservationId" name="ReservationId" />
</div>
