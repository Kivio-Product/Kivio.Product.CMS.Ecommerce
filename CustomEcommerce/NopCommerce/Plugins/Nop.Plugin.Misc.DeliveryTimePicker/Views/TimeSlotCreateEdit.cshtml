@model Nop.Plugin.Misc.DeliveryTimePicker.Models.DeliveryTimeSlotModel
@{
    Layout = "_ConfigurePlugin";
    var isEdit = Model.Id > 0;
    ViewBag.PageTitle = isEdit 
        ? T("Plugins.Misc.DeliveryTimePicker.TimeSlots.Edit").Text 
        : T("Plugins.Misc.DeliveryTimePicker.TimeSlots.AddNew").Text;
}

<form asp-controller="DeliveryTimePicker" 
      asp-action="@(isEdit ? "EditTimeSlot" : "CreateTimeSlot")" 
      method="post">
    <input asp-for="Id" type="hidden" />
    
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="DayOfWeek" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="DayOfWeek" asp-items="Model.AvailableDaysOfWeek" />
                        <span asp-validation-for="DayOfWeek"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="StartTimeString" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="StartTimeString" type="time" class="form-control" required />
                        <span asp-validation-for="StartTimeString" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EndTimeString" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="EndTimeString" type="time" class="form-control" required />
                        <span asp-validation-for="EndTimeString" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="IsEnabled" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="IsEnabled" />
                        <span asp-validation-for="IsEnabled"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MaxCapacity" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="MaxCapacity" type="number" class="form-control" min="1" />
                        <span asp-validation-for="MaxCapacity" class="text-danger"></span>
                        <span class="help-text">@T("Plugins.Misc.DeliveryTimePicker.Time.MaxCapacityHelp")</span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="DisplayOrder" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="DisplayOrder" />
                        <span asp-validation-for="DisplayOrder"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">
                            <i class="far fa-save"></i>
                            @T("Admin.Common.Save")
                        </button>
                        <a asp-controller="DeliveryTimePicker" asp-action="TimeSlotList" class="btn btn-default">
                            @T("Admin.Common.Back")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
