@model Nop.Plugin.Payments.PayU.Models.ConfigurationModel
@inject Nop.Core.IWebHelper webHelper

@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync("StoreScopeConfiguration")

<form asp-controller="PaymentPayU" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="UseSandboxOverrideForStore" asp-input="UseSandbox"
                            asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="UseSandbox" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="UseSandbox" />
                        <span asp-validation-for="UseSandbox"></span>
                    </div>
                </div>
                <!-- Additiona fee enabled -->
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="AdditionalFeeEnabledOverrideForStore"
                            asp-input="AdditionalFeeEnabled" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="AdditionalFeeEnabled" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdditionalFeeEnabled" />
                        <span asp-validation-for="AdditionalFeeEnabled"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AccountId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AccountId" />
                        <span asp-validation-for="AccountId"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MerchantId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MerchantId" />
                        <span asp-validation-for="MerchantId"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ClientLoginId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ClientLoginId" />
                        <span asp-validation-for="ClientLoginId"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ClientSecretKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ClientSecretKey" />
                        <span asp-validation-for="ClientSecretKey"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ClientPublicKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ClientPublicKey" />
                        <span asp-validation-for="ClientPublicKey"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="PaymentDescription" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="PaymentDescription" />
                        <span asp-validation-for="PaymentDescription"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="SelectedCurrencyIdsOverrideForStore"
                            asp-input="SelectedCurrencyIds" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="SelectedCurrencyIds" />
                    </div>
                    <div class="col-md-9">
                        <div class="row">
                            <div class="col-md-4">
                                <nop-select asp-for="SelectedCurrencyIds" asp-items="@Model.AvailableCurrencies"
                                    asp-multiple="true" />
                                <script>
                                    $(function () {
                                        var currencyIdsInput = $('#@Html.IdFor(model => model.SelectedCurrencyIds)').select2({
                                            closeOnSelect: false,
                                             @if (!Model.AvailableCurrencies.Any())
                                            {
                                                <text>
                                                    disabled: true,
                                                    placeholder: 'No currencies available',
                                                </text>
                                            }
                                        });
                                    });
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
