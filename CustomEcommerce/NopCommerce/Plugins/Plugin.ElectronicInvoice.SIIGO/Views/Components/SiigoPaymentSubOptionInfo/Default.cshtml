@using Plugin.ElectronicInvoice.SIIGO
@{
    var selectedSubOptionCode = ViewBag.SelectedSubOptionCode as int?;
    var selectedSubOptionName = ViewBag.SelectedSubOptionName as string;
    var selectedSubOptionDate = ViewBag.SelectedSubOptionDate as DateTime?;
    var paymentMethodName = ViewBag.PaymentMethodName as string;
}

@if (selectedSubOptionCode.HasValue && selectedSubOptionCode.Value > 0 && !string.IsNullOrEmpty(selectedSubOptionName))
{
    <div class="siigo-payment-suboption-info">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">@T("Plugins.ElectronicInvoice.SIIGO.PaymentSubOption.OrderDetail.Title")</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">@T("Plugins.ElectronicInvoice.SIIGO.PaymentSubOption.OrderDetail.SubOption")</label>
                        <p class="form-control-static">@selectedSubOptionName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Plugins.ElectronicInvoice.SIIGO.PaymentSubOption.OrderDetail.SiigoCode")</label>
                        <p class="form-control-static">@selectedSubOptionCode.Value</p>
                    </div>
                </div>
                @if (selectedSubOptionDate.HasValue)
                {
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">@T("Plugins.ElectronicInvoice.SIIGO.PaymentSubOption.OrderDetail.SelectedDate")</label>
                            <p class="form-control-static">@selectedSubOptionDate.Value.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}