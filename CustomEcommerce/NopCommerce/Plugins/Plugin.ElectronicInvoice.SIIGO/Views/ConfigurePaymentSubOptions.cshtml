@using Nop.Web.Framework.Extensions
@using Nop.Web.Framework
@using Plugin.ElectronicInvoice.SIIGO.Models

@model PaymentSubOptionConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    ViewBag.PageTitle = $"Configure Sub-Options for {Model.PaymentMethodFriendlyName}";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        Configure Sub-Options for @Model.PaymentMethodFriendlyName
    </h1>
    <div class="float-right">
        <a asp-controller="Siigo" asp-action="Configure" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to Configuration
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">Payment Sub-Options for @Model.PaymentMethodFriendlyName</h3>
            </div>
            <div class="card-body">
                <div class="form-text text-muted mb-3">
                    Configure specific payment sub-options for @Model.PaymentMethodFriendlyName (e.g., Cash, Transfer, Nequi). 
                    These options will be presented when marking an order as paid in the admin panel.
                </div>
                
                <!-- Existing Sub-Options -->
                @if (Model.SubOptions.Any())
                {
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th>Sub-Option Name</th>
                                    <th>SIIGO Code</th>
                                    <th>Description</th>
                                    <th>Enabled</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subOption in Model.SubOptions)
                                {
                                    <tr>
                                        <td><strong>@subOption.Name</strong></td>
                                        <td><span class="badge badge-info">@subOption.SiigoCode</span></td>
                                        <td>@(subOption.Description ?? "-")</td>
                                        <td>
                                            @if (subOption.IsEnabled)
                                            {
                                                <span class="badge badge-success">Enabled</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Disabled</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-controller="Siigo" asp-action="DeletePaymentSubOption" method="post" style="display: inline;">
                                                <input type="hidden" name="paymentMethodSystemName" value="@Model.PaymentMethodSystemName" />
                                                <input type="hidden" name="subOptionName" value="@subOption.Name" />
                                                <button type="submit" class="btn btn-danger btn-sm" 
                                                        onclick="return confirm('Are you sure you want to delete this sub-option?')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        No sub-options configured for this payment method. Add sub-options below to enable granular payment tracking.
                    </div>
                }

                <!-- Add New Sub-Option -->
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Add New Sub-Option</h5>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Siigo" asp-action="AddPaymentSubOption" method="post">
                            <input type="hidden" name="paymentMethodSystemName" value="@Model.PaymentMethodSystemName" />
                            
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Sub-Option Name</label>
                                        <input asp-for="NewSubOptionName" class="form-control" placeholder="e.g., Efectivo, Transferencia" required />
                                        <small class="form-text text-muted">Name shown to admin users</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>SIIGO Code</label>
                                        <input asp-for="NewSubOptionSiigoCode" class="form-control" placeholder="e.g., 1234" required />
                                        <small class="form-text text-muted">Numeric code from SIIGO</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Description (Optional)</label>
                                        <input asp-for="NewSubOptionDescription" class="form-control" placeholder="e.g., Cash payment received at delivery" />
                                        <small class="form-text text-muted">Additional description</small>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>&nbsp;</label>
                                        <div class="custom-control custom-checkbox">
                                            <input asp-for="NewSubOptionIsEnabled" class="custom-control-input" checked />
                                            <label asp-for="NewSubOptionIsEnabled" class="custom-control-label">Enabled</label>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-block mt-2">
                                            <i class="fas fa-plus"></i> Add Sub-Option
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Suggested Sub-Options for CashOnDelivery -->
                @if (Model.PaymentMethodSystemName == "Payments.CashOnDelivery" && !Model.SubOptions.Any())
                {
                    <div class="card card-outline card-info mt-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Suggested Sub-Options for Cash on Delivery</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Here are some common sub-options for Cash on Delivery payments:</p>
                            <div class="row">
                                <div class="col-md-6">
                                    <form asp-controller="Siigo" asp-action="AddPaymentSubOption" method="post" style="display: inline;">
                                        <input type="hidden" name="paymentMethodSystemName" value="@Model.PaymentMethodSystemName" />
                                        <input type="hidden" name="NewSubOptionName" value="Efectivo" />
                                        <input type="hidden" name="NewSubOptionSiigoCode" value="1" />
                                        <input type="hidden" name="NewSubOptionDescription" value="Cash payment received at delivery" />
                                        <input type="hidden" name="NewSubOptionIsEnabled" value="true" />
                                        <button type="submit" class="btn btn-outline-success btn-block">
                                            <i class="fas fa-money-bill"></i> Add "Efectivo" (Code: 1)
                                        </button>
                                    </form>
                                </div>
                                <div class="col-md-6">
                                    <form asp-controller="Siigo" asp-action="AddPaymentSubOption" method="post" style="display: inline;">
                                        <input type="hidden" name="paymentMethodSystemName" value="@Model.PaymentMethodSystemName" />
                                        <input type="hidden" name="NewSubOptionName" value="Transferencia" />
                                        <input type="hidden" name="NewSubOptionSiigoCode" value="2" />
                                        <input type="hidden" name="NewSubOptionDescription" value="Bank transfer payment received" />
                                        <input type="hidden" name="NewSubOptionIsEnabled" value="true" />
                                        <button type="submit" class="btn btn-outline-info btn-block">
                                            <i class="fas fa-university"></i> Add "Transferencia" (Code: 2)
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>