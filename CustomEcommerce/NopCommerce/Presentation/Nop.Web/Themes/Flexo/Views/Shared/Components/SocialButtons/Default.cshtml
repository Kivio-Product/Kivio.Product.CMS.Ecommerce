@model SocialModel

<ul class="networks">
    @if (!string.IsNullOrEmpty(Model.FacebookLink))
    {
        <li class="facebook"><a href="@Model.FacebookLink" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>
    }
    @if (!string.IsNullOrEmpty(Model.TwitterLink))
    {
        <li class="twitter"><a href="@Model.TwitterLink" aria-label="Twitter" target="_blank" rel="noopener noreferrer"><i class="fa fa-twitter" aria-hidden="true"></i></a></li>
    }
    @if (Model.NewsEnabled)
    {
     <li class="rss"><a href="@Url.RouteUrl("NewsRSS", new {languageId = Model.WorkingLanguageId})" aria-label="RSS">@* @T("Footer.FollowUs.RSS") *@</a></li>
    }
    @if (!string.IsNullOrEmpty(Model.YoutubeLink))
    {
        <li class="youtube"><a href="@Model.YoutubeLink" target="_blank" aria-label="Youtube" rel="noopener noreferrer"><i class="fa fa-youtube" aria-hidden="true"></i></a></li>
    }

    @if (!string.IsNullOrEmpty(Model.InstagramLink))
    {
        <li class="insta-icon"><a href="@Model.InstagramLink" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><i class="fa fa-instagram"></i></a></li>
    }
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = "flexotheme_pinteresturl", additionalData = Model })
</ul>
