@using Nop.Core.Domain.Catalog
@using Nop.Services.Helpers
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@inject CatalogSettings catalogSettings
@inject IThemeContext themeContext
@inject IUserAgentHelper userAgentHelper

@{
    Layout = "";
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var supportRtl = await Html.ShouldUseRtlThemeAsync();

    var urlProyectoExterno = Configuration["KivioModules:Umbraco:UmbracoUrl"];
    var rutaCssProyectoExterno =  Configuration["KivioModules:Umbraco:UmbracoCSSNopCommercePath"];
    bool proyectoExternoDisponible;
    using (var client = new System.Net.Http.HttpClient())
    {
        try
        {
            var response = await client.GetAsync(urlProyectoExterno);
            Console.WriteLine("response.IsSuccessStatusCode: " + response);
            proyectoExternoDisponible = response.IsSuccessStatusCode;
        }
        catch
        {
            proyectoExternoDisponible = false;
        }
    }

    if (proyectoExternoDisponible)
    {
        NopHtml.AppendCssFileParts($"{urlProyectoExterno}{rutaCssProyectoExterno}");
    }
    else
    {
        NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/styles{(supportRtl ? ".rtl" : "")}.css");
    }

    if (catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendCssFileParts("~/lib_npm/swiper/swiper-bundle.min.css");
    }

    NopHtml.AppendCssFileParts("~/lib_npm/jquery-ui-dist/jquery-ui.min.css");
}