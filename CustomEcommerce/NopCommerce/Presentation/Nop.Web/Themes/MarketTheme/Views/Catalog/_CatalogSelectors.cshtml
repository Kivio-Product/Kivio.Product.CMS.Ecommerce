@model CatalogProductsModel

@{
    if (Model.Products.Count <= 0 &&
    !Model.PriceRangeFilter.Enabled &&
    !Model.SpecificationFilter.Enabled &&
    !Model.ManufacturerFilter.Enabled)
    {
        return;
    }
}

<div class="px-filters">
    <div class="px-products-filters">
        <div class="sidebar-handler px-filters-title">
            <a href="javascript:void(0);" class="sidebar-button" id="sidebar-button">
                <h3>Hide Filters</h3>
                <span class="pi-menu-3"><span class="path1"></span><span class="path2"></span><span
                        class="path3"></span><span class="path4"></span></span>
            </a>
        </div>
    </div>

    <div class="product-selectors">

        @* @if (Model.AllowProductViewModeChanging && Model.AvailableViewModes.Count > 1)
        {
            var gridMode = Model.AvailableViewModes[0];
            var listMode = Model.AvailableViewModes[1];

            <div class="product-viewmode">
                <span>@T("Catalog.ViewMode")</span>

                <a href="javascript:void(0);" class="viewmode-icon grid @(gridMode.Selected ? "selected" : null)"
                    data-viewmode="@gridMode.Value" title="@gridMode.Text" aria-label="@gridMode.Text">
                    <span class="pi-menu-2"></span>
                </a>

                <a href="javascript:void(0);" class="viewmode-icon list @(listMode.Selected ? "selected" : null)"
                    data-viewmode="@listMode.Value" title="@listMode.Text" aria-label="@listMode.Text">
                    <span class="pi-list-text"></span>
                </a>
            </div>
        } *@

        @if (Model.AllowProductSorting)
        {
            <div class="product-sorting">
                <span>@T("Catalog.OrderBy")</span>
                @Html.DropDownList("products-orderby", Model.AvailableSortOptions,
                new { aria_label = T("Catalog.OrderBy.Label") })
            </div>
        }

        @if (Model.AllowCustomersToSelectPageSize)
        {
            <div class="product-page-size">
                <span>@T("Catalog.PageSize")</span>
                @Html.DropDownList("products-pagesize", Model.PageSizeOptions,
                new { aria_label = T("Catalog.PageSize.Label") })
                <span>@T("Catalog.PageSize.PerPage")</span>
            </div>
        }
    </div>
</div>

<script asp-location="Footer">
    (function ($) {
        "use strict";

        function updateAndGo(paramName, value) {
            const url = new URL(window.location.href);
            url.searchParams.set(paramName, value);
            url.searchParams.delete('pagenumber');
            window.location.assign(url.toString());
        }

        $(document).on('click', '[data-viewmode]', function (e) {
            e.preventDefault();
            const $this = $(this);
            if ($this.hasClass('selected')) return;

            $('[data-viewmode]').removeClass('selected');
            $this.addClass('selected');

            const mode = $this.data('viewmode');

            if (window.CatalogProducts?.getProducts) {
                $(CatalogProducts).one('before', function (ev) {
                    ev.payload.urlBuilder.addParameter('viewmode', mode);
                });
                CatalogProducts.getProducts();
            } else {
                updateAndGo('viewmode', mode);
            }
        });

        $(document).on('change', '#products-orderby', function () {
            const value = $(this).val();

            if (window.CatalogProducts?.getProducts) {
                $(CatalogProducts).one('before', function (ev) {
                    ev.payload.urlBuilder.addParameter('orderby', value);
                });
                CatalogProducts.getProducts();
            } else {
                updateAndGo('orderby', value);
            }
        });

        $(document).on('change', '#products-pagesize', function () {
            const value = $(this).val();

            if (window.CatalogProducts?.getProducts) {
                $(CatalogProducts).one('before', function (ev) {
                    ev.payload.urlBuilder.addParameter('pagesize', value);
                });
                CatalogProducts.getProducts();
            } else {
                updateAndGo('pagesize', value);
            }
        });

    })(jQuery);
</script>
