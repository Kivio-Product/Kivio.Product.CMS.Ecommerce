@model CheckoutConfirmModel
@inject IThemeContext themeContext
@using Nop.Core.Domain.Topics

@{
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var privacyPolicyPDFPath = Url.Content($"~/Themes/{themeName}/Content/files/politica-tratamiento-datos.pdf");
}

<div class="checkout-data">
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OpCheckoutConfirmTop,
    additionalData = Model })
    @if (!string.IsNullOrEmpty(Model.MinOrderTotalWarning) || Model.Warnings.Count > 0)
    {
        <div class="section confirm-order">
            @if (!string.IsNullOrEmpty(Model.MinOrderTotalWarning))
            {
                <div>
                    <span class="min-order-warning">@Model.MinOrderTotalWarning</span>
                </div>
            }
            @if (Model.Warnings.Count > 0)
            {
                <div class="message-error">
                    <ul>
                        @foreach (var warning in Model.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone =
    PublicWidgetZones.OpCheckoutConfirmBottom, additionalData = Model })
    <div class="section order-summary">
        @await Html.PartialAsync("_OrderReviewData", Model.OrderReviewData)
    </div>
    @if (string.IsNullOrEmpty(Model.MinOrderTotalWarning))
    {
        <div class="checkout-agreements">
            @* Términos y Condiciones *@
            @if (Model.TermsOfServiceOnOrderConfirmPage)
            {
                <div id="terms-of-service-warning-box" title="@T("Checkout.TermsOfService")" style="display:none;">
                    <p>@T("Checkout.TermsOfService.PleaseAccept")</p>
                </div>
                <div class="checkout-terms-box">
                    <label class="modern-checkbox" for="termsofservice">
                        <input type="checkbox" id="termsofservice" name="termsofservice" />
                        <div class="checkbox-custom"></div>
                        <div class="checkbox-text">
                            @T("Checkout.TermsOfService.IAccept")
                            <a class="checkout-link external-link" href="@Url.RouteTopicUrl("conditionsofuse")" target="_blank">
                                @T("Checkout.TermsOfService.Read")
                            </a>
                        </div>
                    </label>
                </div>
            }

            @* Política de Tratamiento de Datos Personales *@
            <div id="privacy-policy-warning-box" title="@T("Checkout.PrivacyPolicy")" style="display:none;">
                <p>@T("Checkout.PrivacyPolicy.PleaseAccept")</p>
            </div>
            <div class="checkout-terms-box">
                <label class="modern-checkbox" for="privacypolicy">
                    <input type="checkbox" id="privacypolicy" name="privacypolicy" />
                    <div class="checkbox-custom"></div>
                    <div class="checkbox-text">
                        @T("Checkout.PrivacyPolicy.IAccept") 
                        <a href="@privacyPolicyPDFPath" target="_blank" class="checkout-link external-link">
                            @T("Checkout.PrivacyPolicy.LinkText")
                        </a> 
                        @T("Checkout.PrivacyPolicy.AcceptText")
                    </div>
                </label>
            </div>
        </div>
    }
    @if (Model.DisplayCaptcha)
    {
        <nop-captcha />
    }
</div>

<script asp-location="Footer">
    // cart item plus minus 
    $(document).ready(function () {
        $('.pi-minus').click(function () {
            var $input = $(this).parent().find('input');
            var count = parseInt($input.val()) - 1;
            count = count < 1 ? 1 : count;
            $input.val(count);
            $input.change();
            return false;
        });
        $('.pi-plus-1').click(function () {
            var $input = $(this).parent().find('input');
            $input.val(parseInt($input.val()) + 1);
            $input.change();
            return false;
        });
    });
</script>