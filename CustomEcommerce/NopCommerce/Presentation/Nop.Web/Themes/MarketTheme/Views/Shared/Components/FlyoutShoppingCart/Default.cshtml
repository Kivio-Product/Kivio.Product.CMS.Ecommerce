@model MiniShoppingCartModel

@using Nop.Core.Domain.Catalog

<div id="flyout-cart" class="flyout-cart">
    <div class="px_mini_shopping_cart_title">
        <h2>@T("Theme.Phoenix.Mini.Shopping.Cart")</h2>

        @if (Model.TotalProducts > 0)
        {
            <div class="px_mini_clear_cart_btn">
                <button  class="clear-cart">@T("Theme.Phoenix.Clear.Cart")</button>
            </div>
        }
    </div>
    <div class="mini-shopping-cart">
        <div class="px_mini_shopping_cart_item">
            @* <div class="count">
                @if (Model.TotalProducts == 0)
                {
                    @T("ShoppingCart.Mini.NoItems")
                }
                else
                {
                    @Html.Raw(string.Format(T("ShoppingCart.Mini.ItemsText").Text, $"<a href=\"{Url.RouteUrl("ShoppingCart")}\">{string.Format(T("ShoppingCart.Mini.Items").Text, Model.TotalProducts)}</a>"))
                }
            </div> *@
            @if (Model.TotalProducts > 0)
            {
                <div class="px_items_scroll">
                    <div class="items">
                        <div id="mini-shopping-cart-items">
                            @for (var i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <div class="item @(i == 0 ? "first" : null)">
                                    @if (Model.ShowProductImages)
                                    {
                                        <div class="picture">
                                            <a href="@(Url.RouteUrl<Product>(new { SeName = item.ProductSeName }))" title="@item.Picture.Title">
                                                <img alt="@item.Picture.AlternateText" src="@item.Picture.ImageUrl" title="@item.Picture.Title" />
                                            </a>
                                        </div>
                                    }
                                    <div class="product">
                                        <div class="name">
                                            <a href="@(Url.RouteUrl<Product>(new { SeName = item.ProductSeName }))">@item.ProductName</a>
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.AttributeInfo))
                                        {
                                            <div class="attributes">
                                                @Html.Raw(item.AttributeInfo)
                                            </div>
                                        }
                                        <div class="price">@T("ShoppingCart.Mini.UnitPrice"): <span>@item.UnitPrice</span></div>
                                        <div class="px-mini-quantity">
                                                <div class="product-quantity">
                                                    <div class="quantity down mini-quantity-down" data-itemid="@item.Id">
                                                        -
                                                    </div>
                                                    <input name="itemquantity@(item.Id)" id="mini-itemquantity@(item.Id)" type="hidden" value="@item.Quantity" />
                                                    <span id="mini-itemquantity-display@(item.Id)" aria-label="@T("ShoppingCart.Quantity")">@item.Quantity</span>
                                                    <div class="quantity up mini-quantity-up" data-itemid="@item.Id">
                                                        +
                                                    </div>
                                                </div>
                                                <div class="remove-item">
                                                    <a class="pi-remove-from-cart px_mini_remove_item" data-itemid="@item.Id"></a>
                                                </div>
                                        </div>                                       
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="px_mini_shopping_cart_total">
            <div class="px_subtotal-main">
                <div class="px_subtotal">
                    <div class="totals">@T("ShoppingCart.Totals.SubTotal"): <strong>@Model.SubTotal</strong></div>
                    <div class="buttons">
                        @if (Model.DisplayShoppingCartButton)
                        {
                            <button type="button" class="button-1 cart-button primary-btn" onclick="setLocation('@(Url.RouteUrl("ShoppingCart"))')">@T("ShoppingCart.Mini.ViewCart")</button>
                        }
                        @if (Model.DisplayCheckoutButton)
                        {
                            var checkoutUrl = "";
                            if (Model.AnonymousCheckoutAllowed && Model.CurrentCustomerIsGuest)
                            {
                                checkoutUrl = Url.RouteUrl("LoginCheckoutAsGuest", new { returnUrl = Url.RouteUrl("ShoppingCart") });
                            }
                            else
                            {
                                checkoutUrl = Url.RouteUrl("Checkout");
                            }
                            <button type="button" class="button-1 checkout-button secoendry-btn" onclick="setLocation('@checkoutUrl')">@T("Checkout.Button")</button>
                        }
                    </div>
                    <button class="continue-shopping">
                        @T("ShoppingCart.Mini.ContinueShopping")
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(function() {
            let isUpdating = false;
            
            initMiniCartEvents();

            function initMiniCartEvents() {
                $('.px_mini_shopping_cart_total .px_subtotal-main .px_subtotal .continue-shopping').off('click');
                $(document).off('click', '.mini-quantity-up');
                $(document).off('click', '.mini-quantity-down');
                $(document).off('click', '.px_mini_remove_item');
                $(document).off('click', '.px_mini_clear_cart_btn button');

                $('.px_mini_shopping_cart_total .px_subtotal-main .px_subtotal .continue-shopping').on('click', function () {
                    $('.flyout-cart').removeClass("slideright active");
                    $('.px_cart_overlay').removeClass("overlayadded");
                    $('body').removeClass("overflowhidden");
                });

                $(document).on('click', '.mini-quantity-up', function () {
                    if (isUpdating) return;
                    
                    var $button = $(this);
                    var itemId = $button.data('itemid');
                    var quantityInput = $('#mini-itemquantity' + itemId);
                    var quantityDisplay = $('#mini-itemquantity-display' + itemId);
                    var oldValue = parseInt(quantityInput.val());
                    var newVal = oldValue + 1;
                    
                    setButtonsDisabled(itemId, true);
                    
                    quantityInput.val(newVal);
                    quantityDisplay.text(newVal);
                    updateMiniCartItem(itemId, newVal);
                });

                $(document).on('click', '.mini-quantity-down', function () {
                    if (isUpdating) return;
                    
                    var $button = $(this);
                    var itemId = $button.data('itemid');
                    var quantityInput = $('#mini-itemquantity' + itemId);
                    var quantityDisplay = $('#mini-itemquantity-display' + itemId);
                    var oldValue = parseInt(quantityInput.val());
                    
                    if (oldValue > 1) {
                        var newVal = oldValue - 1;
                        
                        setButtonsDisabled(itemId, true);
                        
                        quantityInput.val(newVal);
                        quantityDisplay.text(newVal);
                        updateMiniCartItem(itemId, newVal);
                    }
                });

                $(document).on('click', '.px_mini_remove_item', function () {
                    if (isUpdating) return;
                    
                    var itemId = $(this).data('itemid');
                    showRemoveItemConfirmation(function() {
                        removeMiniCartItem(itemId);
                    });
                });

                $(document).on('click', '.px_mini_clear_cart_btn button', function () {
                    if (isUpdating) return;
                    
                    showClearCartConfirmation(function() {
                        clearMiniCart();
                    });
                });
            }

            function setButtonsDisabled(itemId, disabled) {
                isUpdating = disabled;
                
                if (disabled) {
                    $('.mini-quantity-up[data-itemid="' + itemId + '"], .mini-quantity-down[data-itemid="' + itemId + '"]').addClass('disabled');
                } else {
                    $('.mini-quantity-up[data-itemid="' + itemId + '"], .mini-quantity-down[data-itemid="' + itemId + '"]').removeClass('disabled');
                }
            }

            function updateMiniCartItem(itemId, quantity) {
                showLoadingAnimation();
                
                $.ajax({
                    cache: false,
                    url: '@Url.RouteUrl("UpdateMiniCartItem")',
                    data: { 
                        itemId: itemId,
                        quantity: quantity,
                        __RequestVerificationToken: getAntiForgeryToken()
                    },
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            refreshMiniCart();
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: response.message || 'An error occurred while updating the cart',
                                icon: 'error',
                                confirmButtonColor: '#102c5a'
                            });
                            refreshMiniCart();
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error',
                            text: 'An error occurred while updating the cart',
                            icon: 'error',
                            confirmButtonColor: '#102c5a'
                        });
                        refreshMiniCart();
                    },
                    complete: function() {
                        Swal.close();
                        isUpdating = false;
                    }
                });
            }

            function removeMiniCartItem(itemId) {
                showLoadingAnimation();
                isUpdating = true;
                
                $.ajax({
                    cache: false,
                    url: '@Url.RouteUrl("RemoveMiniCartItem")',
                    data: { 
                        itemId: itemId,
                        __RequestVerificationToken: getAntiForgeryToken()
                    },
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            refreshMiniCart();
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: response.message || 'An error occurred while removing the item',
                                icon: 'error',
                                confirmButtonColor: '#102c5a'
                            });
                            refreshMiniCart();
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error',
                            text: 'An error occurred while removing the item',
                            icon: 'error',
                            confirmButtonColor: '#102c5a'
                        });
                        refreshMiniCart();
                    },
                    complete: function() {
                        Swal.close();
                        isUpdating = false;
                    }
                });
            }

            function clearMiniCart() {
                showLoadingAnimation();
                isUpdating = true;
                
                $.ajax({
                    cache: false,
                    url: '@Url.RouteUrl("ClearMiniCart")',
                    data: { 
                        __RequestVerificationToken: getAntiForgeryToken()
                    },
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            refreshMiniCart();
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: response.message || 'An error occurred while clearing the cart',
                                icon: 'error',
                                confirmButtonColor: '#102c5a'
                            });
                            refreshMiniCart();
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error',
                            text: 'An error occurred while clearing the cart',
                            icon: 'error',
                            confirmButtonColor: '#102c5a'
                        });
                        refreshMiniCart();
                    },
                    complete: function() {
                        Swal.close();
                        isUpdating = false;
                    }
                });
            }

            function refreshMiniCart() {
                const wasOpen = $('.flyout-cart').hasClass('active');

                $.ajax({
                    cache: false,
                    url: '@Url.RouteUrl("GetMiniCart")',
                    type: 'GET',
                    success: function (response) {
                        if (!response.success) {
                            console.error('Mini cart response failed.');
                            return;
                        }

                        $('#flyout-cart').replaceWith(response.html);

                        if (wasOpen) {
                            $('.flyout-cart').addClass('slideright active');
                            $('.px_cart_overlay').addClass('overlayadded');
                            $('body').addClass('overflowhidden');
                        }

                        initMiniCartEvents();

                        if (typeof response.totalProducts !== 'undefined') {
                            $('.cart-qty').text(`${response.totalProducts}`);
                        }
                    },
                    error: function () {
                        console.error('Failed to refresh mini cart');
                    },
                    complete: function() {
                        isUpdating = false;
                    }
                });
            }

            function getAntiForgeryToken() {
                return $('input[name="__RequestVerificationToken"]').val();
            }

            function showLoadingAnimation() {
                Swal.fire({
                    title: '',
                    allowEscapeKey: false,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }

            function showRemoveItemConfirmation(confirmCallback) {
                Swal.fire({
                    title: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("Theme.Phoenix.Clear.Cartitem.confirmation").Text))",
                    text: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("Theme.Phoenix.Clear.Cartitem.Confirmation.Description").Text))",
                    icon: 'warning',
                    showCancelButton: true,
                    customClass: {
                        confirmButton: 'primary-btn',
                        cancelButton: 'primary-btn',
                    },
                    confirmButtonColor: '#102c5a',
                    cancelButtonColor: '#102c5a',
                    confirmButtonText: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("Theme.Phoenix.Clear.Cart.confirmation.Confirmbuttontext").Text))",
                    cancelButtonText: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("theme.phoenix.clear.cart.clearbuttontext").Text))",
                }).then((result) => {
                    if (result.isConfirmed) {
                        confirmCallback();
                    }
                });
            }

            function showClearCartConfirmation(confirmCallback) {
                Swal.fire({
                    title: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("Theme.Phoenix.Clear.Cart.Confirmation").Text))",
                    text: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("Theme.Phoenix.Clear.Cart.Confirmation.Description").Text))",
                    icon: 'warning',
                    showCancelButton: true,
                    customClass: {
                        confirmButton: 'primary-btn',
                        cancelButton: 'primary-btn',
                    },
                    confirmButtonColor: '#102c5a',
                    cancelButtonColor: '#102c5a',
                    confirmButtonText: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("Theme.Phoenix.Clear.Cart.confirmation.Confirmbuttontext").Text))",
                    cancelButtonText: "@Html.Raw(JavaScriptEncoder.Default.Encode(T("theme.phoenix.clear.cart.clearbuttontext").Text))",
                }).then((result) => {
                    if (result.isConfirmed) {
                        confirmCallback();
                    }
                });
            }
        });
    </script>
    <style>
        .mini-quantity-up.disabled, .mini-quantity-down.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
    </style>
</div>