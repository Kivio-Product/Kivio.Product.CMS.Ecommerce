@model IList<CategoryModel>

@using Nop.Core.Domain.Catalog

@if (Model.Count > 0)
{
    <div class="section-padding category-grid home-page-category-grid">
        <div class="item-grid px_category_slider owl-carousel">
            @foreach (var item in Model)
            {
                <div class="item-box px_category">
                    <div class="category-item">
                        <div class="picture">
                            <a href="@(Url.RouteUrl<Category>(new { SeName = item.SeName }))" title="@item.PictureModel.Title">
                                <img alt="@item.PictureModel.AlternateText" src="@item.PictureModel.ImageUrl" title="@item.PictureModel.Title" />
                                <div class="px_category_hover">
                                </div>
                            </a>
                        </div>
                        <div class="category-name-wrapper">
                            <span class="category-name">
                                @item.Name
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<script asp-location="Footer">
    $(".px_category_slider").owlCarousel({
        autoplay: false,
        loop: false,
        rtl: true,
        margin: 0,
        responsiveClass: true,
        autoHeight: false,
        autoplayTimeout: 7000,
        smartSpeed: 800,
        dots: false,
        nav: false,
        responsive: {
            0: {
                items: 4
            },

            600: {
                items: 6
            },

            1024: {
                items: 9
            },

            1366: {
                items: 9
            }
        }
    });

</script>