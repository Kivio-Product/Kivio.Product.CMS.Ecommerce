@model IList<ProductOverviewModel>
@using Nop.Core
@inject IWorkContext workContext
@if (Model.Count > 0)
{
    <div class="section-padding section-bg product-grid home-page-product-grid">
        <div class="section-width">
            <div class="flash-sale-container">
                <div class="flash-sale-info">
                    <div class="flash-icon desktop-only">
                        <div class="flash-icon-image"></div>
                    </div>
                    <h2 class="flash-title">@T("HomePageProducts.Title")</h2>
                    <div class="timer-section">
                        <span class="timer-label desktop-only">Termina en</span>
                        <div class="countdown-timer">
                            <span class="time-segment" id="hours">00</span>
                            <span class="separator">:</span>
                            <span class="time-segment" id="minutes">00</span>
                            <span class="separator">:</span>
                            <span class="time-segment" id="seconds">00</span>
                        </div>
                    </div>
                    <div class="flash-title-mobile mobile-only">
                        <span>@T("HomePageProducts.TitleMobile")</span>
                    </div>
                    <div class="decorative-arrow">
                        <div class="decorative-arrow-image"></div>
                    </div>
                </div>
                <a href="@T("HomePageProducts.Button.ViewAll.Url")" class="view-all-button desktop-only">
                    @T("HomePageProducts.Button.ViewAll")
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>

            @{
                var highDiscountProducts = Model.Where(p => p.HasHighDiscount).ToList();
                var regularDiscountProducts = Model.Where(p => !p.HasHighDiscount).ToList();
            }

            @if (highDiscountProducts.Any())
            {
                <div class="high-discount-container">
                    <div id="high-discount-products" class="item-grid high-discount-row">
                    @foreach (var item in highDiscountProducts)
                    {
                        <div class="item-box high-discount-box">
                            @await Html.PartialAsync("_ProductBox", item)
                        </div>
                    }
                    </div>
                </div> 
            }

            @if (regularDiscountProducts.Any())
            {
                <div id="regular-discount-products" class="item-grid regular-discount-row">
                    @foreach (var item in regularDiscountProducts)
                    {
                        <div class="item-box">
                            @await Html.PartialAsync("_ProductBox", item)
                        </div>
                    }
                </div>
            }

            <div class="view-all-mobile mobile-only">
                <a href="@T("HomePageProducts.Button.ViewAll.Url")" class="view-all-button">
                    @T("HomePageProducts.Button.ViewAll")
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </div>
}

<script asp-location="Footer">
    $(document).ready(function () {
        function setupProductDisplay() {
            var highDiscountContainer = $('#high-discount-products');
            var regularDiscountContainer = $('#regular-discount-products');

            if (window.innerWidth <= 767) {
                if (highDiscountContainer.length) {
                    var highDiscountCount = highDiscountContainer.find('.item-box').length;

                    if (highDiscountCount > 2) {
                        if (!highDiscountContainer.hasClass('owl-carousel')) {
                            highDiscountContainer.removeClass('mobile-grid high-discount-row');
                            highDiscountContainer.addClass('owl-carousel px_featured');
                            highDiscountContainer.owlCarousel({
                                autoplay: false,
                                loop: false,
                                rtl: true,
                                responsiveClass: true,
                                navigation: true,
                                dots: false,
                                nav: true,
                                items: 2,
                                margin: 8,
                                stagePadding: 0,
                                center: false
                            });
                        }
                    } else {
                        if (highDiscountContainer.hasClass('owl-carousel')) {
                            highDiscountContainer.trigger('destroy.owl.carousel');
                            highDiscountContainer.removeClass('owl-carousel px_featured');
                            highDiscountContainer.find('.owl-stage-outer, .owl-stage, .owl-item').each(function () {
                                $(this).removeAttr('style');
                            });
                        }
                        highDiscountContainer.addClass('mobile-grid high-discount-row');
                        highDiscountContainer.find('.item-box').show();
                    }
                }

                if (regularDiscountContainer.length) {
                    var regularDiscountCount = regularDiscountContainer.find('.item-box').length;

                    if (regularDiscountCount > 2) {
                        if (!regularDiscountContainer.hasClass('owl-carousel')) {
                            regularDiscountContainer.removeClass('mobile-grid regular-discount-row');
                            regularDiscountContainer.addClass('owl-carousel px_featured');
                            regularDiscountContainer.owlCarousel({
                                autoplay: false,
                                loop: false,
                                rtl: false,
                                responsiveClass: true,
                                autoHeight: false,
                                navigation: true,
                                dots: false,
                                nav: true,
                                items: 2,
                                center: false
                            });
                        }
                    } else {
                        if (regularDiscountContainer.hasClass('owl-carousel')) {
                            regularDiscountContainer.trigger('destroy.owl.carousel');
                            regularDiscountContainer.removeClass('owl-carousel px_featured');
                            regularDiscountContainer.find('.owl-stage-outer, .owl-stage, .owl-item').each(function () {
                                $(this).removeAttr('style');
                            });
                        }
                        regularDiscountContainer.addClass('mobile-grid regular-discount-row');
                        regularDiscountContainer.find('.item-box').show();
                    }
                }

            } else {
                highDiscountContainer.removeClass('mobile-grid');
                regularDiscountContainer.removeClass('mobile-grid');

                highDiscountContainer.find('.item-box').show();
                regularDiscountContainer.find('.item-box').show();

                if (highDiscountContainer.length && highDiscountContainer.find('.item-box').length > 3 && !highDiscountContainer.hasClass('owl-carousel')) {
                    highDiscountContainer.addClass('owl-carousel px_featured');
                    highDiscountContainer.css('width', '60%');
                    highDiscountContainer.owlCarousel({
                        autoplay: false,
                        loop: false,
                        rtl: true,
                        responsiveClass: true,
                        autoHeight: true,
                        navigation: true,
                        dots: false,
                        nav: true,
                        responsive: {
                            0: {
                                items: 1
                            },
                            600: {
                                items: 2
                            },
                            1024: {
                                items: 3
                            }
                        }
                    });
                    $('.regular-discount-row').css('margin-top', '40px');
                } else {
                    highDiscountContainer.css('width', '100%');
                    $('.regular-discount-row').css('margin-top', '');
                }

                if (regularDiscountContainer.length && regularDiscountContainer.find('.item-box').length > 5 && !regularDiscountContainer.hasClass('owl-carousel')) {
                    regularDiscountContainer.addClass('owl-carousel px_featured');
                    regularDiscountContainer.owlCarousel({
                        autoplay: false,
                        loop: false,
                        rtl: true,
                        responsiveClass: true,
                        autoHeight: true,
                        navigation: true,
                        dots: false,
                        nav: true,
                        responsive: {
                            0: {
                                items: 1
                            },
                            600: {
                                items: 2
                            },
                            1024: {
                                items: 5
                            },
                            1366: {
                                items: 5
                            }
                        }
                    });
                }
            }
        }

        setupProductDisplay();

        var resizeTimer;
        $(window).resize(function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                setupProductDisplay();
            }, 250);
        });
    });

    function startCountdown() {
        const hoursElement = document.getElementById('hours');
        const minutesElement = document.getElementById('minutes');
        const secondsElement = document.getElementById('seconds');

        const targetHourCOL = 18;
        const targetMinuteCOL = 0;
        const targetSecondCOL = 0;

        function updateTimer() {
            const now = new Date();

            let targetDate = new Date(Date.UTC(
                now.getUTCFullYear(),
                now.getUTCMonth(),
                now.getUTCDate(),
                targetHourCOL + 5,
                targetMinuteCOL,
                targetSecondCOL
            ));

            if (now.getTime() > targetDate.getTime()) {
                targetDate.setUTCDate(targetDate.getUTCDate() + 1);
            }

            const diff = targetDate.getTime() - now.getTime();

            if (diff <= 0) {
                hoursElement.textContent = '00';
                minutesElement.textContent = '00';
                secondsElement.textContent = '00';
                return;
            }

            const hours = Math.floor(diff / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            hoursElement.textContent = String(hours).padStart(2, '0');
            minutesElement.textContent = String(minutes).padStart(2, '0');
            secondsElement.textContent = String(seconds).padStart(2, '0');
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    }

    if (document.getElementById('hours') && document.getElementById('minutes') && document.getElementById('seconds')) {
        document.addEventListener('DOMContentLoaded', startCountdown);
    }
</script>