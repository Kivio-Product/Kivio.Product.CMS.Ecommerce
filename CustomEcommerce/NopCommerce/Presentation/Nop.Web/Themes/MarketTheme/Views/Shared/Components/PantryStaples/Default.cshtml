@model PantryStaplesModel

@if (Model.Products.Any())
{
    <div class="pantry-staples-section">
        <div class="section-header">
            <div class="section-icon-title">
                <img src="@Url.Content("~/Themes/MarketTheme/Content/images/pantry-staples-icon.png")" alt="@T("PantryStaples.Icon")" class="pantry-icon" />
                <h2 class="section-title">@T("PantryStaples.Title")</h2>
            </div>
            <a href="@Url.RouteUrl("Category", new { SeName = Model.CategorySeName })" class="view-all-link view-all-link-desktop">@T("PantryStaples.ViewAll")
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>

        <div class="pantry-content">
            <div class="widget-column">
                @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.HomepageTop, additionalData = Model.CategoryName.ToUpper() })
            </div>

            <div class="products-column">
                <div id="pantry-staples-products" class="item-grid super-deal-row pantry-staples-grid">
                    @foreach (var item in Model.Products)
                    {
                        <div class="item-box">
                            @await Html.PartialAsync("_ProductBox", item)
                        </div>
                    }
                </div>
            </div>
        </div>
        <a href="@Url.RouteUrl("Category", new { SeName = Model.CategorySeName })" class="view-all-link view-all-link-mobile">@T("PantryStaples.ViewAll")
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </a>
    </div>
}