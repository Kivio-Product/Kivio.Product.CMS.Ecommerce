@model SearchBoxModel
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Media
@inject MediaSettings mediaSettings

@{
    var shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart;

    var uniqueId = Guid.NewGuid().ToString("N")[..8];
    var searchInputId = $"searchterms-{uniqueId}";
    var searchFormId = $"search-form-{uniqueId}";
    var searchResultsId = $"search-results-{uniqueId}";
    var searchSuggestionsId = $"search-suggestions-{uniqueId}";
    var searchProductsId = $"search-products-{uniqueId}";
    var searchFooterId = $"search-footer-{uniqueId}";
}

<form asp-route="ProductSearch" method="get" id="@searchFormId" class="search-form-container" data-unique-id="@uniqueId">
    @if (Model.ShowSearchBox)
    {
        <div class="search-box-wrapper">
            <button type="submit" class="search-box-button">
                <span class="pi-search"></span>
            </button>

            <input type="text" class="search-box-text" id="@searchInputId" autocomplete="off" name="q"
                placeholder="@T("search.searchbox.tooltip")" 
                aria-label="@T("Theme.Phoenix.Search.SearchBox.Text.Label")"
                data-unique-id="@uniqueId" />

            <!-- Contenedor de resultados mejorado -->
            <div id="@searchResultsId" class="search-results-container" style="display: none;" data-unique-id="@uniqueId">
                <div id="@searchSuggestionsId" class="search-section">
                    <!-- Sugerencias de términos aparecerán aquí -->
                </div>
                <div id="@searchProductsId" class="search-section">
                    <!-- Productos aparecerán aquí -->
                </div>
                <div id="@searchFooterId" class="search-footer" style="display: none;">
                    <!-- Link "Ver todos los resultados" aparecerá aquí -->
                </div>
            </div>
        </div>

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.SearchBoxBeforeSearchButton, additionalData = Model })

    @if (Model.SearchTermMinimumLength > 0)
    {
        <script asp-location="Footer">
            $("#@searchFormId").on("submit", function (event) {
                if ($("#@searchInputId").val() == "") {
                    Swal.fire({
                        title: '<strong>@Html.Raw(JavaScriptEncoder.Default.Encode(T("Search.EnterSearchTerms").Text))</strong>',
                        icon: 'error',
                        customClass: {
                            confirmButton: 'primary-btn',
                        }
                    })
                    $("#@searchInputId").focus();
                    event.preventDefault();
                }
            });
        </script>
    }

    @if (Model.AutoCompleteEnabled)
    {
        <script asp-location="Footer">
            $(function () {
                // Crear instancia específica para este searchbox
                const uniqueId = '@uniqueId';
                const searchInputSelector = '#@searchInputId';
                const searchResultsSelector = '#@searchResultsId';
                const searchSuggestionsSelector = '#@searchSuggestionsId';
                const searchProductsSelector = '#@searchProductsId';
                const searchFooterSelector = '#@searchFooterId';
                const formSelector = '#@searchFormId';
                
                let searchTimeout;
                let currentRequest;
                let isUpdating = false;

                // Función para mostrar popup de límite (reutiliza ProductBoxCartAnimation si está disponible)
                function showLimitPopup(message, title) {
                    if (window.ProductBoxCartAnimation && typeof window.ProductBoxCartAnimation.showLimitPopup === 'function') {
                        window.ProductBoxCartAnimation.showLimitPopup(message, title);
                        return;
                    }

                    // Fallback si ProductBoxCartAnimation no está disponible
                    message = message || '⚠️ No puedes agregar más unidades. La cantidad seleccionada supera el stock disponible.';
                    title = title || 'Límite de cantidad alcanzado';
                    
                    if (typeof displayBarNotification !== 'undefined') {
                        try {
                            displayBarNotification(message, 'error', 3500);
                        } catch(e) {
                            alert(message);
                        }
                    } else {
                        alert(message);
                    }
                }

                function showResults() {
                    $(searchResultsSelector).slideDown(200);
                }

                function hideResults() {
                    $(searchResultsSelector).slideUp(200);
                }

                function updateQuantity(productId, change) {
                    const input = $(searchResultsSelector + ` #search-qty-${productId}-${uniqueId}`);
                    let currentValue = parseInt(input.val()) || 1;
                    const minQty = parseInt(input.attr('data-min')) || 1;
                    const maxQty = parseInt(input.attr('data-max')) || 999;

                    let newValue = Math.max(minQty, currentValue + change);
                    newValue = Math.min(newValue, maxQty);

                    input.val(newValue);
                    
                    // Actualizar estado de botones
                    toggleQuantityButtons(productId, newValue, maxQty);
                }

                function toggleQuantityButtons(productId, currentQty, maxQty) {
                    const $plusBtn = $(searchResultsSelector + ` .qty-plus[data-productid="${productId}"]`);
                    const $minusBtn = $(searchResultsSelector + ` .qty-minus[data-productid="${productId}"]`);
                    
                    // Deshabilitar botón + si alcanzó el máximo
                    if (currentQty >= maxQty) {
                        $plusBtn
                            .addClass('disabled')
                            .attr('aria-disabled', 'true')
                            .css({
                                'opacity': '0.5',
                                'cursor': 'not-allowed',
                                'pointer-events': 'auto'
                            });
                    } else {
                        $plusBtn
                            .removeClass('disabled')
                            .removeAttr('aria-disabled')
                            .css({
                                'opacity': '1',
                                'cursor': 'pointer',
                                'pointer-events': 'auto'
                            });
                    }
                    
                    // Deshabilitar botón - si está en el mínimo
                    if (currentQty <= 1) {
                        $minusBtn
                            .addClass('disabled')
                            .css('opacity', '0.5');
                    } else {
                        $minusBtn
                            .removeClass('disabled')
                            .css('opacity', '1');
                    }
                }

                function setQuantityControlsDisabled(productId, disabled) {
                    const quantityControls = $(searchResultsSelector + ` .search-product-${productId} .quantity-controls button, ` + searchResultsSelector + ` .search-product-${productId} .add-to-cart-btn`);
                    if (disabled) {
                        quantityControls.addClass('disabled').prop('disabled', true);
                    } else {
                        quantityControls.removeClass('disabled').prop('disabled', false);
                    }
                }

                function addToCart(productId) {
                    if (isUpdating) return;

                    const quantity = parseInt($(searchResultsSelector + ` #search-qty-${productId}-${uniqueId}`).val()) || 1;
                    const addButton = $(searchResultsSelector + ` #search-add-btn-${productId}-${uniqueId}`);

                    isUpdating = true;
                    setQuantityControlsDisabled(productId, true);

                    // Cambiar texto del botón
                    addButton.html('<i class="pi-loading pi-spin"></i> Agregando...');

                    // Construir la URL correcta
                    const addtocartlink = `/addproducttocart/catalog/${productId}/@shoppingCartTypeId/${quantity}`;

                    // Usar AjaxCart.addproducttocart_catalog
                    AjaxCart.addproducttocart_catalog(addtocartlink);

                    // Restaurar botón después de un delay
                    setTimeout(function () {
                        addButton.html('<i class="pi-shopping-cart"></i> Agregar');
                        setQuantityControlsDisabled(productId, false);
                        isUpdating = false;

                        // Limpiar búsqueda y ocultar resultados
                        hideResults();
                        $(searchInputSelector).val('');
                    }, 2000);
                }

                function performSearch(term) {
                    if (term.length < @(Model.SearchTermMinimumLength.ToString())) {
                        hideResults();
                        return;
                    }

                    // Cancelar request anterior
                    if (currentRequest) {
                        currentRequest.abort();
                    }

                    currentRequest = $.ajax({
                        url: '@(Url.RouteUrl("ProductSearchAutoComplete"))',
                        method: 'GET',
                        data: { term: term },
                        success: function (data) {
                            if (!data.hasResults) {
                                hideResults();
                                return;
                            }

                            // Renderizar sugerencias de términos
                            let suggestionsHtml = '';
                            if (data.suggestions && data.suggestions.length > 0) {
                                suggestionsHtml = '<div class="section-header">Búsquedas relacionadas</div>';
                                data.suggestions.forEach(function (suggestion) {
                                    suggestionsHtml += `
                                        <div class="suggestion-item" data-term="${suggestion.text}" data-unique-id="${uniqueId}">
                                            <i class="pi-search"></i>
                                            <span class="suggestion-text">${suggestion.text}</span>
                                        </div>
                                    `;
                                });
                            }
                            $(searchSuggestionsSelector).html(suggestionsHtml);

                            // Renderizar productos (máximo 3)
                            let productsHtml = '';
                            if (data.products && data.products.length > 0) {
                                productsHtml = '<div class="section-header">Productos destacados</div>';
                                data.products.forEach(function (product) {
                                    const imageUrl = product.imageUrl || '/images/thumbs/default-image_100.png';
                                    const stockClass = product.isInStock ? 'in-stock' : 'out-of-stock';
                                    const stockText = product.isInStock ? 'En stock' : 'Agotado';
                                    const maxQty = product.stockQuantity;
                                    const minQty = product.minOrderQuantity || 1;

                                    const quantityControls = product.isInStock ?
                                        `<div class="quantity-wrapper">
                                            <div class="quantity-controls">
                                                <button type="button" class="qty-btn qty-minus" data-productid="${product.id}" data-change="-1" data-unique-id="${uniqueId}">−</button>
                                                <input type="number" id="search-qty-${product.id}-${uniqueId}" class="qty-input" value="${minQty}" 
                                                       min="${minQty}" max="${maxQty}" 
                                                       data-min="${minQty}" data-max="${maxQty}" readonly>
                                                <button type="button" class="qty-btn qty-plus" data-productid="${product.id}" data-change="1" data-unique-id="${uniqueId}">+</button>
                                            </div>
                                            <button type="button" id="search-add-btn-${product.id}-${uniqueId}" class="add-to-cart-btn" data-productid="${product.id}" data-unique-id="${uniqueId}">
                                                <i class="pi-shopping-cart"></i> Agregar
                                            </button>
                                         </div>` :
                                        `<div class="quantity-wrapper">
                                            <button type="button" class="add-to-cart-btn disabled" disabled>
                                                <i class="pi-times"></i> Agotado
                                            </button>
                                         </div>`;

                                    productsHtml += `
                                        <div class="product-item search-product-${product.id}" data-unique-id="${uniqueId}">
                                            <div class="product-image">
                                                <a href="${product.productUrl}">
                                                    <img src="${imageUrl}" alt="${product.name}" loading="lazy">
                                                </a>
                                            </div>
                                            <div class="product-info">
                                                <div class="product-name">
                                                    <a href="${product.productUrl}">${product.name}</a>
                                                </div>
                                                <div class="product-price">${product.price}</div>
                                                <span class="stock-indicator ${stockClass}">${stockText}</span>
                                            </div>
                                            ${quantityControls}
                                        </div>
                                    `;
                                });
                            }
                            $(searchProductsSelector).html(productsHtml);

                            // Footer con link a resultados completos
                            if (data.showLinkToResultSearch) {
                                $(searchFooterSelector).html(`
                                    <a href="/search?q=${encodeURIComponent(data.searchTerm)}" class="view-all-results">
                                        <i class="pi-search"></i> Ver todos los resultados para "${data.searchTerm}"
                                    </a>
                                `).show();
                            } else {
                                $(searchFooterSelector).hide();
                            }

                            showResults();
                        },
                        error: function (xhr) {
                            if (xhr.statusText !== 'abort') {
                                hideResults();
                            }
                        }
                    });
                }

                // Event handlers específicos para esta instancia
                $(searchInputSelector).on('input', function () {
                    const term = $(this).val().trim();
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(function () {
                        performSearch(term);
                    }, 300);
                });

                $(searchInputSelector).on('focus', function () {
                    const term = $(this).val().trim();
                    if (term.length >= @(Model.SearchTermMinimumLength.ToString())) {
                        performSearch(term);
                    }
                });

                // Click en sugerencia de término - específico para esta instancia
                $(document).on('click', `[data-unique-id="${uniqueId}"].suggestion-item`, function () {
                    const term = $(this).data('term');
                    $(searchInputSelector).val(term);
                    $(formSelector).submit();
                });

                // Event handlers para controles de cantidad - específico para esta instancia
                $(document).on('click', `[data-unique-id="${uniqueId}"].qty-btn`, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    if (isUpdating || $(this).hasClass('disabled')) {
                        // Si es el botón + y está deshabilitado, mostrar popup
                        if ($(this).hasClass('qty-plus') && $(this).hasClass('disabled')) {
                            showLimitPopup();
                        }
                        return;
                    }

                    const productId = $(this).data('productid');
                    const change = parseInt($(this).data('change'));
                    const input = $(searchResultsSelector + ` #search-qty-${productId}-${uniqueId}`);
                    const currentValue = parseInt(input.val()) || 1;
                    const maxQty = parseInt(input.attr('data-max')) || 999;
                    
                    // Si intenta aumentar y ya está en el máximo, mostrar popup
                    if (change > 0 && currentValue >= maxQty) {
                        showLimitPopup();
                        return;
                    }
                    
                    updateQuantity(productId, change);
                });

                // Event handler para agregar al carrito - específico para esta instancia
                $(document).on('click', `[data-unique-id="${uniqueId}"].add-to-cart-btn:not(.disabled)`, function () {
                    if (isUpdating) return;

                    const productId = $(this).data('productid');
                    addToCart(productId);
                });

                // Click fuera para ocultar resultados - específico para esta instancia
                $(document).on('click', function (e) {
                    if (!$(e.target).closest(formSelector).length) {
                        hideResults();
                    }
                });

                // Exponer funciones globalmente con nombre único
                window['updateQuantity_' + uniqueId] = updateQuantity;
                window['addToCart_' + uniqueId] = addToCart;
            });
        </script>
    }
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.SearchBox, additionalData = Model })
        }
</form>