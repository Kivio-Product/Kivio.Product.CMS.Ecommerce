@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Services.Catalog
@using Nop.Services.Security
@using Nop.Services.Stores
@using Nop.Web.Factories
@using Nop.Web.Models.Catalog

@inject IProductModelFactory _productModelFactory
@inject IProductService _productService
@inject IProductTagService _productTagService
@inject IStoreContext _storeContext
@inject IWorkContext _workContext
@inject IAclService _aclService
@inject IStoreMappingService _storeMappingService

@{
    var productThumbPictureSize = 280;

    var defaultFilterTagName = "best-prices";

    var defaultBestPricesTag = "best-prices";
    var defaultMostOrderedTag = "most-ordered";
    var defaultBestRatedTag = "best-rated";

    var localeTagName = T("Home.FilteredProducts.DefaultTag").Text;

    var localeBestPricesTag = T("Home.FilteredProducts.BestPricesTag").Text;
    var localeMostOrderedTag = T("Home.FilteredProducts.MostOrderedTag").Text;
    var localeBestRatedTag = T("Home.FilteredProducts.BestRatedTag").Text;

    var localeBestPricesText = T("Home.FilteredProducts.BestPricesText").Text;
    var localeMostOrderedText = T("Home.FilteredProducts.MostOrderedText").Text;
    var localeBestRatedText = T("Home.FilteredProducts.BestRatedText").Text;    

    var initialFilterTagName = !string.IsNullOrWhiteSpace(localeTagName) && localeTagName !=
    "Home.FilteredProducts.DefaultTag" ? localeTagName : defaultFilterTagName;

    var finalBestPricesText = !string.IsNullOrWhiteSpace(localeBestPricesText) && localeBestPricesText != "Home.FilteredProducts.BestPricesText" 
        ? localeBestPricesText : "Mejores precios";
    var finalMostOrderedText = !string.IsNullOrWhiteSpace(localeMostOrderedText) && localeMostOrderedText != "Home.FilteredProducts.MostOrderedText" 
        ? localeMostOrderedText : "Los más pedidos";
    var finalBestRatedText = !string.IsNullOrWhiteSpace(localeBestRatedText) && localeBestRatedText != "Home.FilteredProducts.BestRatedText" 
        ? localeBestRatedText : "Los mejor calificados";

    var finalBestPricesTag = !string.IsNullOrWhiteSpace(localeBestPricesTag) && localeBestPricesTag != "Home.FilteredProducts.BestPricesTag" 
        ? localeBestPricesTag : defaultBestPricesTag;
    var finalMostOrderedTag = !string.IsNullOrWhiteSpace(localeMostOrderedTag) && localeMostOrderedTag != "Home.FilteredProducts.MostOrderedTag" 
        ? localeMostOrderedTag : defaultMostOrderedTag;
    var finalBestRatedTag = !string.IsNullOrWhiteSpace(localeBestRatedTag) && localeBestRatedTag != "Home.FilteredProducts.BestRatedTag" 
        ? localeBestRatedTag : defaultBestRatedTag;

    int? initialProductTagId = null;

    var tags = await _productTagService.GetAllProductTagsAsync(tagName: initialFilterTagName);
    var initialProductTag = tags.FirstOrDefault();

    if (initialProductTag == null && initialFilterTagName != defaultFilterTagName)
    {
        tags = await _productTagService.GetAllProductTagsAsync(tagName: defaultFilterTagName);
        initialProductTag = tags.FirstOrDefault();
        initialFilterTagName = defaultFilterTagName;
    }

    if (initialProductTag != null)
    {
        initialProductTagId = initialProductTag.Id;
    }

    var initialProducts = await _productService.SearchProductsAsync(
        storeId: (await _storeContext.GetCurrentStoreAsync()).Id,
        productTagId: (int) initialProductTagId,
        visibleIndividuallyOnly: true,
        overridePublished: false,
        orderBy: ProductSortingEnum.Position,
        pageSize: 6
    );

    var initialProductModels = (await _productModelFactory.PrepareProductOverviewModelsAsync(
        initialProducts,
        preparePriceModel: true,
        preparePictureModel: true,
        productThumbPictureSize: productThumbPictureSize,
        prepareSpecificationAttributes: false,
        forceRedirectionAfterAddingToCart: false
    )).ToList();
}

<div class="custom-product-section">
    <div class="filter-section">
        <span class="section-title">@T("Home.FilteredProducts.SectionTitle")</span>

        <div class="filters-bar">
            <button class="filter-button active" data-filter-tag="@finalBestPricesTag">@finalBestPricesText</button>
            <button class="filter-button" data-filter-tag="@finalMostOrderedTag">@finalMostOrderedText</button>
            <button class="filter-button" data-filter-tag="@finalBestRatedTag">@finalBestRatedText</button>
        </div>
    </div>
    <div class="products-container">
        <div class="ajax-products-busy" style="display: none; text-align: center; padding: 20px;">
            <img src="@Url.Content("/Themes/MarketTheme/Content/css/ajax-loader.gif")" alt="Loading..." />
        </div>
        <div class="products-wrapper" id="custom-products-grid">
            @{ await Html.RenderPartialAsync("_CustomProductGridItems",initialProductModels); }
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('.filters-bar .filter-button').on('click', function () {
            var $button = $(this);
            if ($button.hasClass('active')) {
                return; 
            }

            $('.filters-bar .filter-button').removeClass('active');
            $button.addClass('active');

            var filterTagName = $button.data('filter-tag'); // This will be the tag name
            var $grid = $('#custom-products-grid');
            var $loader = $('.ajax-products-busy');

            $loader.show();
            $grid.html(''); 

            $.ajax({
                cache: false,
                url: '@Url.Action("GetFilteredProducts", "CustomProductSection")',
                data: {
                    productTagName: filterTagName, 
                    productThumbPictureSize: @productThumbPictureSize
                },
                type: 'GET',
                success: function (response) {
                    $grid.html(response);
                    if (typeof AjaxCart !== 'undefined' && typeof AjaxCart.init !== 'undefined') {
                        AjaxCart.init(false, '.header-links .cart-qty', '.header-links .wishlist-qty', '#flyout-cart');
                    }
                    $(document).trigger('nopAjaxCartResponse');
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    console.error('Error loading products:', thrownError);
                    $grid.html('<div class="no-products">Error loading products. Please try again.</div>');
                },
                complete: function () {
                    $loader.hide();
                }
            });
        });
    });
</script>
